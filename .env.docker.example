# Template for .env.docker (untracked). `npm run setup` creates it with random values.
# Manual: copy this file to .env.docker and replace every change-me value with a NEW random one;
# never reuse a leaked password. Generate one (cross-platform, needs Node):
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# These only initialise an EMPTY MySQL volume (to change an existing DB use ALTER USER, docs/security.md).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=knot_dev
MYSQL_USER=knot
MYSQL_PASSWORD=change-me-app
MYSQL_HOST_PORT=3306    # host port (127.0.0.1 only); change if 3306 is already used by another MySQL
