# ─────────────────────────────────────────────────────────────────────────────
# K-not — kök .env (yalnızca ön yüz / Vite). `npm run setup` bu dosyayı otomatik oluşturur.
# Yalnızca VITE_* değişkenleri tarayıcı paketine girer — buraya ASLA gizli değer yazma.
#
# Her servisin kendi ortam dosyası var (hepsini setup oluşturur ve birbirine eşitler):
#   .env.docker           MySQL konteyneri (kök)          ← .env.docker.example
#   backend/.env          NestJS API                      ← backend/.env.example
#   ai-service/.env       Python RAG / ingestion servisi  ← ai-service/.env.example
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api                       # tarayıcıdan API'ye aynı-köken yol
VITE_API_PROXY_TARGET=http://localhost:3000  # dev/preview proxy hedefi = backend adresi (pakete girmez)

# ── İsteğe bağlı: yalnızca betikler/testler okur (kabuk ortam değişkeni olarak da verilebilir) ──
# PYTHON=python3                       # test:e2e'nin kullanacağı Python (varsayılan: python3)
# CHROMIUM_PATH=/path/to/chrome        # test:e2e ve tarayıcı betikleri için Chromium/Chrome/Edge yolu
# E2E_DATABASE_URL=mysql://knot:...@localhost:3306/knot_e2e   # test:e2e için BOŞ, ayrı veritabanı
# MOMENTSEARCH_ROOT=C:\\yol\\MomentSearch   # video motoru klasörü (varsayılan ../MomentSearch); github.com/azrashn/momentsearch, bkz. docs/video-integration.md
# PDFTOPPM_PATH=/usr/bin/pdftoppm      # Poppler; PATH'te değilse tam yol (PDF/PPTX görsel önizleme)
