#!/usr/bin/env bash
# K-not pre-commit hook. Enable once per clone:  git config core.hooksPath .githooks
# Blocks forbidden files by name and scans the staged changes with gitleaks (redacted output).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-forbidden-files.sh" --staged
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; install it (see docs/security.md) to commit." >&2
  exit 1
fi
gitleaks git --staged --redact --verbose --no-banner --config "$root/.gitleaks.toml" "$root"
