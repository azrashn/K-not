# K-not RAG service (WBS-3) — copy to .env and fill in. Never commit real secrets.

# ── Internal authentication (NestJS → Python) ───────────────────────────────────
# Shared secret. NestJS sends it as `Authorization: Bearer <token>` (or X-Internal-Token).
RAG_INTERNAL_API_TOKEN=change-me-to-a-long-random-string
# Only for local development without NestJS. Never true in a deployed environment.
RAG_AUTH_DISABLED=false

# ── ChromaDB (index written by WBS-2) ───────────────────────────────────────────
CHROMA_MODE=http                 # http | persistent | memory
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PATH=./.chroma            # used when CHROMA_MODE=persistent
CHROMA_COLLECTION=knot_chunks_v1 # must match the collection WBS-2 writes

# ── Embeddings: MUST equal the ACTIVE IndexVersion (C-1 fingerprint is checked) ──
# MVP model selected by ADR-010 (docs/architecture/architecture-decisions.md §3.1). The code
# default (config.py) is still MiniLM; set these explicitly. Prefixes include a trailing space.
# Fingerprint: sha256:7858637ffe512d13b894af08f99e75f8f42be36c457e2e02192bacdfd6671616
EMBEDDING_BACKEND=sentence_transformers  # sentence_transformers | hashing (tests/offline only)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# ── LLM provider ────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai_compatible   # openai_compatible | extractive (offline baseline, not an LLM)
LLM_BASE_URL=http://localhost:11434/v1   # e.g. local Ollama; or any OpenAI-compatible gateway
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=                     # empty for local models
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_JSON_MODE=true               # sends response_format=json_object; disable if the server rejects it
LLM_MAX_ATTEMPTS=2               # retries only malformed output / transient errors, never timeouts
# Spend/transmission policy. Default: no external calls, $0. A non-loopback LLM_BASE_URL is refused
# at start-up unless ALL four are set; the budget is a hard cap per process (providers/policy.py).
LLM_ALLOW_EXTERNAL=false         # true only after the team approves sending evidence to that provider
LLM_BUDGET_USD=0
LLM_PRICE_INPUT_PER_MTOK=        # provider list price, USD per 1M input tokens
LLM_PRICE_OUTPUT_PER_MTOK=

# ── Retrieval & context (defaults are starting points, see docs/rag-evaluation.md) ──
RAG_TOP_K=8
RAG_MAX_EVIDENCE=6
RAG_MIN_SCORE=                   # empty = no floor. Calibrate per embedding model before setting.
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_CHUNKS_PER_DOCUMENT=4
RAG_CHARS_PER_TOKEN=3.0
RAG_LEXICAL_CHANNEL=true         # hybrid retrieval: exact question terms (IDF) fused with dense ranking
RAG_LEXICAL_POOL=50              # max chunks fetched per question term

# ── Support assessment (citation-lexical-v2; see docs/rag-architecture.md §6) ───
SUPPORT_COVERAGE_SUPPORTED=0.6           # S3: claim terms in the quoted sentence
SUPPORT_COVERAGE_PARTIAL=0.3             # U2
SUPPORT_QUESTION_RELEVANCE_MIN=0.34      # S7, calibrated on eval.v1
SUPPORT_RELATIVE_RELEVANCE_MIN=0.6       # S7, relative to the most relevant claim
SUPPORT_MAX_UNSUPPORTED_TERMS=0          # S8: claim terms absent from all cited passages before SIKI is withheld
RAG_QUESTION_COVERAGE_ANSWERED=0.6       # below this the answer is PARTIALLY_ANSWERED
SUPPORT_JUDGE=none                       # none | llm (needs a separate judge provider; the generator may not judge itself)
SUPPORT_REQUIRE_SEMANTIC_CONFIRMATION=false  # true: unconfirmed SIKI is shown as GEVEŞEK

# ── WBS-2 ingestion (docs/architecture/wbs2-handoff.md §10) ─────────────────────
INGEST_ENABLED=false             # mounts /api/v1/ingestion/* (same internal token as /api/v1/rag/*)
STORAGE_ROOT=/var/lib/knot/storage   # shared volume with NestJS; originals + pages.{v}.json artifacts
NESTJS_INTERNAL_URL=http://nestjs:3000   # callback base URL (internal network only)
INGEST_CALLBACK_TOKEN=change-me-to-another-long-random-string   # separate secret for callbacks
INGEST_WORKER_CONCURRENCY=1
INGEST_QUEUE_CAPACITY=20
INGEST_HEARTBEAT_SECONDS=30
INGEST_EMBED_BATCH_SIZE=32
INGEST_MAX_PAGES=400
INGEST_MAX_EMPTY_PAGE_RATIO=0.5
INGEST_SUPPORTED_INDEXING_VERSIONS=c1

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RAG_LOG_QUESTIONS=false          # true logs raw question text; keep false outside local dev
