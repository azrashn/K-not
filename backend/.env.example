# K-not backend (WBS-4). Copy to .env; never commit real secrets.
PORT=3000
DATABASE_URL=mysql://knot:change-me@localhost:3306/knot
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_TTL_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
STORAGE_ROOT=/var/lib/knot/storage          # same volume as the ai-service STORAGE_ROOT
AI_SERVICE_URL=http://localhost:8100
RAG_INTERNAL_API_TOKEN=change-me-shared-with-ai-service
INGEST_CALLBACK_TOKEN=change-me-different-secret-shared-with-ai-service
LLM_TIMEOUT_SECONDS=30                     # answer timeout = this + 5 s (match the ai-service)
UPLOAD_MAX_BYTES=31457280                  # 30 MB (ADR-004)
INGEST_STALL_TIMEOUT_SECONDS=300
INGEST_MAX_AUTO_ATTEMPTS=3
SCHEDULER_ENABLED=true
ANSWER_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=info
