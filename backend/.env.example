# K-not backend (WBS-4). `npm run setup` (repo root) creates backend/.env from this file, generates the
# secrets and syncs DATABASE_URL / tokens / STORAGE_ROOT with ai-service/.env and .env.docker.
# Manual: copy to backend/.env; never commit real secrets.
PORT=3000
DATABASE_URL=mysql://knot:change-me@localhost:3306/knot_dev   # MySQL 8 (docker compose). User/password/db/port = .env.docker (URL-encode special chars)
JWT_SECRET=change-me-to-at-least-32-random-characters   # >= 32 chars
JWT_TTL_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
STORAGE_ROOT=/var/lib/knot/storage          # ABSOLUTE path, same folder as the ai-service STORAGE_ROOT (setup uses <repo>/data/storage)
AI_SERVICE_URL=http://localhost:8100
VIDEO_SERVICE_URL=http://127.0.0.1:7862      # OPTIONAL external MomentSearch video engine (NOT in this repo). If it is not running only the video endpoints fail; see docs/video-integration.md
RAG_INTERNAL_API_TOKEN=change-me-shared-with-ai-service   # >= 16 chars; MUST equal ai-service/.env
INGEST_CALLBACK_TOKEN=change-me-different-secret-shared-with-ai-service   # >= 16 chars; MUST equal ai-service/.env
LLM_TIMEOUT_SECONDS=30                     # answer timeout = this + 5 s (match the ai-service)
UPLOAD_MAX_BYTES=31457280                  # 30 MB (ADR-004)
INGEST_STALL_TIMEOUT_SECONDS=300
INGEST_MAX_AUTO_ATTEMPTS=3
SCHEDULER_ENABLED=true
ANSWER_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=info
