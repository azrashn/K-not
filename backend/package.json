{
  "name": "knot-backend",
  "version": "0.1.0",
  "private": true,
  "description": "K-not WBS-4: NestJS backend (auth, courses, documents, ingestion orchestration, RAG proxy)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node scripts/seed.ts",
    "test": "jest --config jest.config.js --selectProjects unit api",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:api": "jest --config jest.config.js --selectProjects api",
    "test:integration": "jest --config jest.config.js --selectProjects integration --runInBand",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "29.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9"
  }
}
