// K-not WBS-4 relational model. Field and enum names follow docs/architecture/data-model.md
// (binding for the cross-module contracts). MySQL 8 is required (nullable composite unique).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "" // extensionless: resolves .js in dist/ (npm start) and .ts under ts-node/jest
}

datasource db {
  provider = "mysql"
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  CHUNKING
  EMBEDDING
  INDEXING
  READY
  FAILED
  DELETING
}

enum JobStatus {
  QUEUED
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobKind {
  INITIAL
  RETRY
  REINDEX
  MIGRATION
}

enum Visibility {
  PRIVATE
  COURSE
}

enum MembershipRole {
  STUDENT
  INSTRUCTOR
}

enum UserRole {
  USER
  ADMIN
}

enum IndexVersionStatus {
  BUILDING
  ACTIVE
  RETIRED
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique @db.VarChar(254)
  displayName  String             @db.VarChar(120)
  passwordHash String             @db.VarChar(255)
  role         UserRole           @default(USER)
  createdAt    DateTime           @default(now())
  memberships  CourseMembership[]
  documents    Document[]
  createdCourses Course[]         @relation("CourseCreator")
  quizzes      Quiz[]
  quizAttempts QuizAttempt[]
}

model Course {
  id             String             @id @default(cuid())
  code           String             @db.VarChar(32)
  name           String             @db.VarChar(200)
  instructorName String?            @db.VarChar(200)
  term           String             @db.VarChar(32)
  description    String?            @db.VarChar(1000)
  createdById    String?            // set for student-created personal courses; NULL for seeded/enrolled ones
  createdAt      DateTime           @default(now())
  createdBy      User?              @relation("CourseCreator", fields: [createdById], references: [id])
  memberships    CourseMembership[]
  documents      Document[]
  quizzes        Quiz[]

  @@unique([code, term])
  @@index([createdById])
}

model CourseMembership {
  userId    String
  courseId  String
  role      MembershipRole
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  course    Course         @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
  @@index([courseId])
}

model Document {
  id                String                  @id // cuid generated by the app before insert
  courseId          String
  ownerId           String
  visibility        Visibility              @default(PRIVATE)
  documentType      String                  @db.VarChar(16) // slide|notes|textbook|past_exam|other
  title             String                  @db.VarChar(300)
  originalFilename  String                  @db.VarChar(255)
  mimeType          String                  @db.VarChar(100)
  sizeBytes         Int
  contentSha256     String                  @db.Char(64)
  activeContentHash String?                 @db.Char(64) // = contentSha256 until deleted, then NULL
  storageKey        String                  @db.VarChar(255)
  pageCount         Int?
  chunkCount        Int?
  status            DocumentStatus          @default(UPLOADED)
  failedStage       DocumentStatus?
  errorCode         String?                 @db.VarChar(64)
  errorMessage      String?                 @db.VarChar(500)
  errorRetryable    Boolean?
  activeJobId       String?                 @unique
  indexingVersion   String?                 @db.VarChar(64)
  indexVersionId    String?
  readyAt           DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  purgedAt          DateTime?
  course            Course                  @relation(fields: [courseId], references: [id])
  owner             User                    @relation(fields: [ownerId], references: [id])
  indexVersion      IndexVersion?           @relation(fields: [indexVersionId], references: [id])
  jobs              DocumentProcessingJob[] @relation("DocumentJobs")

  @@unique([courseId, ownerId, activeContentHash])
  @@index([courseId, status, deletedAt])
  @@index([ownerId])
  @@index([deletedAt, purgedAt])
}

model DocumentProcessingJob {
  id              String          @id @default(cuid())
  documentId      String
  indexVersionId  String
  kind            JobKind
  status          JobStatus       @default(QUEUED)
  stage           DocumentStatus?
  attempt         Int             @default(1)
  indexingVersion String          @db.VarChar(64)
  lastEventSeq    Int             @default(0)
  workerId        String?         @db.VarChar(64)
  nextAttemptAt   DateTime?
  dispatchedAt    DateTime?
  startedAt       DateTime?
  heartbeatAt     DateTime?
  finishedAt      DateTime?
  pageCount       Int?
  chunkCount      Int?
  errorCode       String?         @db.VarChar(64)
  errorMessage    String?         @db.VarChar(500)
  retryable       Boolean?
  createdAt       DateTime        @default(now())
  document        Document        @relation("DocumentJobs", fields: [documentId], references: [id])
  indexVersion    IndexVersion    @relation(fields: [indexVersionId], references: [id])

  @@index([status, heartbeatAt])
  @@index([status, nextAttemptAt])
  @@index([documentId, createdAt])
  @@index([indexVersionId, status])
}

model IndexVersion {
  id                   String                  @id @default(cuid())
  collectionName       String                  @unique @db.VarChar(63)
  embeddingBackend     String                  @db.VarChar(64)
  embeddingModel       String                  @db.VarChar(255)
  embeddingRevision    String?                 @db.VarChar(64)
  embeddingDimension   Int
  queryPrefix          String                  @default("") @db.VarChar(64)
  documentPrefix       String                  @default("") @db.VarChar(64)
  normalize            Boolean                 @default(true)
  distance             String                  @default("cosine") @db.VarChar(16)
  embeddingFingerprint String                  @unique @db.VarChar(80)
  chunkerVersion       String                  @db.VarChar(64)
  status               IndexVersionStatus      @default(BUILDING)
  activatedAt          DateTime?
  retiredAt            DateTime?
  droppedAt            DateTime?
  jobs                 DocumentProcessingJob[]
  documents            Document[]
}

enum QuizStatus {
  READY
  FAILED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

// Generated from the selected READY documents. Owned by one student; the answer key lives only here.
model Quiz {
  id             String         @id @default(cuid())
  userId         String
  courseId       String
  title          String         @db.VarChar(200)
  status         QuizStatus     @default(READY)
  difficulty     String         @db.VarChar(8)   // easy|medium|hard
  questionTypes  String         @db.VarChar(64)  // comma list: multiple_choice,true_false
  requestedCount Int
  questionCount  Int
  generator      String         @db.VarChar(64)  // e.g. extractive-v1
  llmUsed        Boolean        @default(false)
  warnings       String?        @db.Text         // JSON array of user-facing notes
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id])
  course         Course         @relation(fields: [courseId], references: [id])
  documents      QuizDocument[]
  questions      QuizQuestion[]
  attempts       QuizAttempt[]

  @@index([userId, courseId, createdAt])
}

model QuizDocument {
  quizId     String
  documentId String
  quiz       Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([quizId, documentId])
  @@index([documentId])
}

model QuizQuestion {
  id               String              @id @default(cuid())
  quizId           String
  ordinal          Int
  type             String              @db.VarChar(16)   // multiple_choice|true_false
  prompt           String              @db.Text
  options          String              @db.Text          // JSON string[]
  correctIndex     Int
  explanation      String              @db.Text
  topic            String              @db.VarChar(300)
  difficulty       String              @db.VarChar(8)
  sourceDocumentId String              @db.VarChar(191)
  sourceChunkId    String              @db.VarChar(191)
  sourcePageStart  Int?
  sourcePageEnd    Int?
  sourceQuote      String?             @db.Text          // cleared when the source document is deleted (no stored excerpts of deleted documents)
  quiz             Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers          QuizAttemptAnswer[]

  @@unique([quizId, ordinal])
  @@index([sourceDocumentId])
}

model QuizAttempt {
  id           String              @id @default(cuid())
  quizId       String
  userId       String
  status       QuizAttemptStatus   @default(IN_PROGRESS)
  startedAt    DateTime            @default(now())
  submittedAt  DateTime?
  totalCount   Int                 @default(0)
  correctCount Int                 @default(0)
  scorePct     Int?                // 0..100, set on submit
  quiz         Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id])
  answers      QuizAttemptAnswer[]

  @@index([userId, status, submittedAt])
  @@index([quizId])
}

model QuizAttemptAnswer {
  attemptId     String
  questionId    String
  selectedIndex Int?
  isCorrect     Boolean?
  answeredAt    DateTime     @default(now())
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([attemptId, questionId])
  @@index([questionId])
}
